# Backend (Vercel serverless) — tidak pernah di-commit nilainya.
# Generate dengan: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Cron Secret (string acak untuk verifikasi cron request)
CRON_SECRET=

# Vercel KV (otomatis di-set oleh Vercel saat KV database di-connect)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Frontend: lihat frontend/.env.example untuk VITE_VAPID_PUBLIC_KEY
